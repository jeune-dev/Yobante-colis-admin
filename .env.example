# Adresse du backend yobnate-colis-back, utilisée par le proxy du serveur de dev
# (le navigateur appelle /api, Vite relaie vers cette adresse).
VITE_API_PROXY_TARGET=http://localhost:5001

# En production (build statique), URL publique de l'API, préfixe /api/v1 compris
# (ex. https://yobnate-colis-back.onrender.com/api/v1). Laisser vide pour conserver
# /api derrière un reverse proxy (Nginx) qui relaie vers le backend.
VITE_API_URL=
