# Adresse du backend yobnate-colis-back, utilisée par le proxy du serveur de dev
# (le navigateur appelle /api, Vite relaie vers cette adresse).
VITE_API_PROXY_TARGET=http://localhost:5001

# En production, laisser VIDE (recommandé) : l'admin appelle /api sur son propre domaine,
# relayé vers le backend par Nginx (deploy/) ou par la réécriture de render.yaml. Le
# refresh token reste alors dans le cookie httpOnly du backend, jamais en localStorage.
# Une URL absolue (ex. https://api.exemple.com/api/v1) fonctionne encore mais oblige à
# conserver le refresh token côté navigateur (cookie sameSite strict non envoyé entre sites).
VITE_API_URL=
